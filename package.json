{
  "name": "pi-test-runner-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5173\"",
    "build": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test server/**/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "telnet-client": "^2.2.14",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
